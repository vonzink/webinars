{
  "$comment": "Which source folder ships at which path under /webinars/. Paths are relative to the repository root. Add a webinar here and a card in shell/webinars/index.html; the build verifies both agree.",
  "exclude": [
    ".DS_Store",
    ".playwright-cli",
    "__pycache__",
    "output",
    "scripts",
    "tests",
    "build_pptx.py",
    "content.json",
    "package.json",
    "package-lock.json",
    "node_modules",
    "README.md",
    "DEPLOY.md",
    "SLIDE_DESIGN_SPEC.md",
    "CONTENT-REVIEW.md",
    "CONTENT-APPROVAL.json"
  ],
  "webinars": [
    {
      "slug": "homebuyers-webinar",
      "title": "The Homebuyer's Playbook",
      "source": "first-time-homebuyer/deck",
      "downloads": [
        { "from": "first-time-homebuyer/Homebuyers-Playbook.pptx", "to": "downloads/homebuyers-playbook-webinar.pptx" },
        { "from": "first-time-homebuyer/Homebuyers-Playbook.pptx", "to": "downloads/homebuyers-playbook-webinar-editable.pptx" }
      ]
    },
    {
      "slug": "va",
      "title": "Understanding VA Loans",
      "source": "va-loans/deck",
      "downloads": [
        { "from": "va-loans/Understanding-VA-Loans.pptx", "to": "downloads/understanding-va-loans.pptx" }
      ]
    },
    {
      "slug": "le-cd",
      "title": "Understand Your Loan Estimate and Closing Disclosure",
      "source": "cd-webinar",
      "exclude": ["CD Webinar"],
      "downloads": []
    },
    {
      "slug": "first-home-without-mystery",
      "title": "Your first home, without the mystery.",
      "source": "first-home-without-mystery/deck",
      "downloads": []
    },
    {
      "slug": "reverse-mortgages",
      "title": "Reverse Mortgages",
      "source": "reverse-mortgages/deck",
      "exclude": [
        "logo-horizontal.png", "logo-knockout.svg", "logo-mark-only-knockout.svg", "logo-mark-only.svg",
        "logo-stacked.png", "logo-stacked.svg", "presentation-qr.png", "presentation-qr.svg",
        "qr-seth.png", "webinar-qr.png"
      ],
      "downloads": []
    },
    {
      "$comment": "Webinar Studio: the Reverse Mortgages deck's pages and engine, with webinar-studio/ laid over it (its own starter slides, a config that reads the webinar's name from the address, and home.html, the list of webinars). Staff reach it from the Dashboard, so it has no card on the library page.",
      "slug": "studio",
      "title": "Webinar Studio",
      "source": "reverse-mortgages/deck",
      "overlay": "webinar-studio",
      "unlisted": true,
      "exclude": [
        "logo-horizontal.png", "logo-knockout.svg", "logo-mark-only-knockout.svg", "logo-mark-only.svg",
        "logo-stacked.png", "logo-stacked.svg", "presentation-qr.png", "presentation-qr.svg",
        "qr-seth.png", "webinar-qr.png"
      ],
      "downloads": []
    }
  ]
}
