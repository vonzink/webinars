      "downloads": [
        { "from": "first-time-homebuyer/Homebuyers-Playbook.pptx", "to": "downloads/Homebuyers-Playbook.pptx" }
      ]
    },
    {
      "slug": "va",
      "title": "Understanding VA Loans",
      "source": "va-loans/deck",
      "downloads": [
        { "from": "va-loans/Understanding-VA-Loans.pptx", "to": "downloads/Understanding-VA-Loans.pptx" }
      ]
    },
    {
      "slug": "le-cd",
      "title": "Understand Your Loan Estimate and Closing Disclosure",
      "source": "cd-webinar",
      "exclude": ["CD Webinar"],
      "downloads": []
    }
  ]
