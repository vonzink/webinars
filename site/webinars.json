{
  "$comment": "Which source folder ships at which path under /webinars/. Paths are relative to the repository root. Add a webinar here and a card in shell/webinars/index.html; the build verifies both agree.",
  "exclude": [
    ".DS_Store",
    ".playwright-cli",
    "__pycache__",
    "output",
    "scripts",
    "tests",
    "build_pptx.py",
    "content.json",
